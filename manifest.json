{
  "manifest_version": 3,
  "name": "Shush!",
  "version": "1.0.1",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "122",
  "permissions": [
    "tabs",
    "notifications",
    "contextMenus",
    "scripting",
    "storage",
    "favicon"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Shush!",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-mute-current": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "__MSG_cmdToggleMute__"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
